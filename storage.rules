rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Concert photos/videos — see lib/photos.js. Path shape:
    //   showPhotos/{concertKey}/{uid}/{fileName}
    // Read requires auth (matches the showPhotos Firestore rule — anyone
    // signed in who's logged the concert can view). Write is limited to
    // the uploader's own uid segment, capped at 10MB, and restricted to
    // images or MP4 video — kept in sync with lib/photos.js's
    // ALLOWED_TYPES/MAX_FILE_BYTES. Delete additionally allows the admin
    // account (kept in sync with ADMIN_EMAILS in lib/constants.js), for
    // moderation of a file whose Firestore doc was deleted by an admin.
    match /showPhotos/{concertKey}/{uid}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.auth.uid == uid
        && request.resource.size < 10 * 1024 * 1024
        && (request.resource.contentType.matches('image/.*')
            || request.resource.contentType == 'video/mp4');
      allow delete: if request.auth != null
        && (request.auth.uid == uid
            || request.auth.token.get('admin', false) == true
            || (request.auth.token.get('email_verified', false) == true
                && request.auth.token.get('email', '') == 'phillip.leonard@gmail.com'));
    }

    // Venue verification proof documents (business license, tax ID, etc.)
    // — see lib/venues.js. Path shape:
    //   venueVerificationDocs/{venueSegment}/{uid}/{fileName}
    // Only the applicant and the admin (who reviews applications) can read;
    // write is limited to the applicant's own uid segment. No delete — kept
    // as a permanent audit trail of what was submitted.
    match /venueVerificationDocs/{venueSegment}/{uid}/{fileName} {
      allow read: if request.auth != null
        && (request.auth.uid == uid
            || request.auth.token.email == 'phillip.leonard@gmail.com');
      allow write: if request.auth != null
        && request.auth.uid == uid
        && request.resource.size < 10 * 1024 * 1024
        && (request.resource.contentType.matches('image/.*')
            || request.resource.contentType == 'application/pdf');
    }

    // Official venue photos — see lib/venues.js. Path shape:
    //   venuePhotos/{venueSegment}/{uid}/{fileName}
    // Anyone signed in can view; write/delete limited to the uploader
    // (the verified venue owner) or the admin.
    match /venuePhotos/{venueSegment}/{uid}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.auth.uid == uid
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if request.auth != null
        && (request.auth.uid == uid
            || request.auth.token.email == 'phillip.leonard@gmail.com');
    }
  }
}
