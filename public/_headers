# ── Default: block indexing on all paths ──────────────────────
# Netlify matches top-to-bottom; more-specific paths below override.
/*
  X-Robots-Tag: noindex, nofollow

# ── Public pages: allow indexing ──────────────────────────────
/
  X-Robots-Tag: index, follow

/privacy
  X-Robots-Tag: index, follow

/terms
  X-Robots-Tag: index, follow

/cookies
  X-Robots-Tag: index, follow

/shared/*
  X-Robots-Tag: index, follow

/artists
  X-Robots-Tag: index, follow

/artists/
  X-Robots-Tag: index, follow

/artist/*
  X-Robots-Tag: index, follow

# A user's own pages: out of search results, links followed (setlist.fm's
# API terms forbid discouraging search engines from following its
# attribution links). These are function responses, which _headers rules
# do not reach, so public-profile.js and public-show.js send the same value
# themselves (USER_PAGE_ROBOTS); this entry documents it.
/u/*
  X-Robots-Tag: noindex, follow

# Songs I've heard (netlify/functions/lib/heardPages.js). Share links,
# /heard/<slug>/r/<code>/, are personal: the function sends noindex for
# them itself, and the rule below keeps them out whatever this one says.
/heard
  X-Robots-Tag: index, follow

/heard/*
  X-Robots-Tag: index, follow

/heard/*/r/*
  X-Robots-Tag: noindex, follow

# Personal posters (netlify/functions/lib/myPosters.js), shared at
# /p/<code>/: function responses, which send noindex themselves; this
# entry documents it. The app's /my-poster/ keeps the default above.
/p/*
  X-Robots-Tag: noindex, follow

# Comparison pages (lib/comparePages.js)
/compare/concert-archives
  X-Robots-Tag: index, follow

/compare/concert-archives/
  X-Robots-Tag: index, follow

/compare/setlist-fm
  X-Robots-Tag: index, follow

/compare/setlist-fm/
  X-Robots-Tag: index, follow

/best-concert-tracker-apps-jam-bands
  X-Robots-Tag: index, follow

/best-concert-tracker-apps-jam-bands/
  X-Robots-Tag: index, follow

/switch/concert-archives
  X-Robots-Tag: index, follow

/switch/concert-archives/
  X-Robots-Tag: index, follow

# iOS universal links (lib/deepLinks.js). Apple fetches this file with no
# extension and needs it served as JSON, not as the default octet-stream.
/.well-known/apple-app-site-association
  Content-Type: application/json
