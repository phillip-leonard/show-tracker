rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Moderation helpers (v5.32.0, App Store Guideline 1.2) ─────────
    //
    // The admin address is duplicated from ADMIN_EMAILS in
    // lib/constants.js — rules can't import app code, which is the same
    // reason the literal already appears inline throughout this file.
    // These helpers replace those literals where a moderation check needs
    // them, so a future change to the list has fewer places to reach.
    //
    // `.get('email', '')` rather than a bare `request.auth.token.email`:
    // a token without an email claim makes the bare read an evaluation
    // error rather than a clean false. Both end in a denial, so this is
    // not a hole — but an error is harder to read in the emulator logs
    // than a false, and it means a rule that ORs this with another
    // condition would fail instead of falling through to it.
    function isAdmin() {
      return request.auth != null
             && request.auth.token.get('email', '') == 'phillip.leonard@gmail.com';
    }

    // A banned account keeps its data and its reads; what it loses is the
    // ability to add anything new. `banned` lives on userProfiles (rather
    // than with the block list in userBlocks) precisely so a rule can read
    // it — userBlocks is owner-only by design and get() here would fail.
    //
    // COST. Each call is a document read charged to the project. It is
    // applied only to the collections that carry user-generated content
    // shown to other people, not to a user's own private shows and
    // festivals, so the ordinary logging path is unaffected.
    //
    // A missing profile is not banned: get() returns null for a document
    // that does not exist, and a user whose profile has not been written
    // yet must still be able to take part.
    function isNotBanned() {
      return request.auth != null
             && !(exists(/databases/$(database)/documents/userProfiles/$(request.auth.uid))
                  && get(/databases/$(database)/documents/userProfiles/$(request.auth.uid))
                       .data.get('banned', false) == true);
    }

    // User shows — owner writes, any authenticated user reads (for Shows Together)
    match /users/{userId}/shows/{showId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Upcoming shows (v5.43.0) — shows the user is going to. Owner-only,
    // unlike shows above: nothing needs to read someone else's (Shows
    // Together compares past shows), and a friend tagged on one gets their
    // own copy through showTags when they accept. Kept out of
    // users/{uid}/shows so no stat, total or server function counts them.
    // Removed with the users/{uid} subtree on account deletion.
    match /users/{userId}/upcomingShows/{upcomingId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Per-user festival ATTENDANCE records (v5.30.0). Same path and the
    // same owner-only rule these have always had — what changed is what
    // they contain: a pointer (`festivalId`) to a shared canonical
    // festival below, plus this user's own notes, rating and (via
    // festivalId on the show doc) their own attached shows. Nothing here
    // is readable by anyone else, which is what makes "join someone's
    // festival" safe: the joiner's notes and shows stay private to them.
    // Pre-5.30.0 records that still hold their own name/dates keep working
    // untouched under exactly this rule until the migration reaches them.
    match /users/{userId}/festivals/{festivalId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // User friends list
    match /users/{userId}/friends/{friendId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if request.auth != null
        && (request.auth.uid == userId || request.auth.uid == friendId);
    }

    // Public profiles.
    //
    // The `banned` flag lives here so isNotBanned() above can read it, and
    // that makes the write rule load-bearing: the previous
    // `allow write: if request.auth.uid == userId` would have let a banned
    // user clear their own ban with one updateDoc, which would have made
    // the whole ban action decorative. Only the admin flow (through the
    // Admin SDK, which bypasses these rules) may set it; a user's own
    // write must leave it exactly as it is.
    //
    // `.get(key, default)` rather than a bare field read: almost every
    // existing profile predates this field, and a bare read of a missing
    // field fails rule evaluation outright — which would lock every
    // current user out of editing their own profile.
    // ── The four fields a client may never write (v5.36.2) ─────────────
    //
    // displayName, firstName, handle and handleLower are published text:
    // the name sits beside every comment, photo, friend card and activity
    // row, and the handle becomes a public URL (/u/{handle}). They are
    // filtered by lib/contentFilter.js, and a filter a client can skip is
    // advice rather than a gate — so the client is taken off the write
    // path entirely and netlify/functions/moderate-content.js, which runs
    // the wordlist before writing, is the only writer. Its Admin SDK
    // bypasses these rules, which is what makes that work.
    //
    // `.get(field, '')` on both sides rather than a bare read: almost
    // every existing profile predates handle/handleLower, and a bare read
    // of a missing field fails rule evaluation outright — which would
    // lock every current user out of writing any part of their profile.
    function textFieldsUnchanged() {
      return request.resource.data.get('displayName', '')
               == resource.data.get('displayName', '')
          && request.resource.data.get('firstName', '')
               == resource.data.get('firstName', '')
          && request.resource.data.get('handle', '')
               == resource.data.get('handle', '')
          && request.resource.data.get('handleLower', '')
               == resource.data.get('handleLower', '');
    }

    match /userProfiles/{userId} {
      allow read: if request.auth != null;
      // A profile is created by the client on first load (see
      // updateUserProfile in AppContext) but must arrive without any of
      // the published text on it — the server establishes the name a
      // moment later. Creating with a name is how an unfiltered one would
      // otherwise get in on a brand new account.
      // `isTestUser` (v5.44.0) marks an account the admin Users and Stats
      // tabs leave out by default. Admin-set only: an owner can neither
      // create a profile carrying it nor change it, or anyone could take
      // themselves out of (or put themselves into) the numbers.
      allow create: if request.auth != null
                    && request.auth.uid == userId
                    && request.resource.data.get('banned', false) == false
                    && !request.resource.data.keys().hasAny(
                         ['displayName', 'firstName', 'handle', 'handleLower', 'isTestUser']);
      allow update: if request.auth != null
                    && request.auth.uid == userId
                    && request.resource.data.get('banned', false)
                       == resource.data.get('banned', false)
                    && request.resource.data.get('isTestUser', false)
                       == resource.data.get('isTestUser', false)
                    && textFieldsUnchanged();
      // The admin may flip isTestUser on anyone's profile, and nothing
      // else: the admin's client is no more trusted with the rest of a
      // profile than the owner's is.
      allow update: if isAdmin()
                    && request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly(['isTestUser'])
                    && request.resource.data.isTestUser is bool;
      allow delete: if false;
    }

    // ── Handle reservations (v5.36.2) ──────────────────────────────────
    // uid -> handle is 1:1 and the uniqueness transaction lives in
    // moderate-content.js, so nothing here needs to be client-writable.
    //
    // This collection previously had NO rule at all and Firestore denies
    // any path without one, so the client transaction in lib/handles.js
    // could never commit — nobody has ever successfully claimed a handle.
    // Reads stay open to signed-in users so the "is this taken?" check
    // under the field still works without a round trip to a function.
    match /handles/{handleLower} {
      allow read:  if request.auth != null;
      allow write: if false;
    }

    // ── Blocked accounts (v5.32.0) ─────────────────────────────────────
    // One document per user (id = uid) holding the uids they have blocked.
    //
    // NOT stored on userProfiles, deliberately. That document is readable
    // by every signed-in user, so a block list on it would tell the person
    // you blocked that you blocked them — the one thing a block must never
    // do. Private, owner-only, same uid-keyed shape as favoriteTours
    // above, including the docId pin: matching on the userId field alone
    // would let any signed-in user overwrite someone else's block list by
    // writing to userBlocks/<their-uid> with their own userId in the body.
    match /userBlocks/{docId} {
      allow read: if request.auth != null
                  && docId == request.auth.uid;
      allow create, update: if request.auth != null
                  && docId == request.auth.uid
                  && request.resource.data.userId == request.auth.uid;
      allow delete: if false;
    }

    // ── Reports (v5.32.0) ──────────────────────────────────────────────
    // Guideline 1.2's "mechanism for users to report offensive content".
    //
    // Reports are created by netlify/functions/report-content.js through
    // the Admin SDK, which is what makes the auto-hide count trustworthy —
    // a client that could write these directly could file three reports
    // under three ids and hide anything it liked. The create rule below
    // still exists and still pins reporterId to the caller: it is the
    // fallback if the function is ever unavailable, and it is what the
    // rules test asserts.
    //
    // Reads are admin-only. A report names its reporter, and a reporter
    // whose name is visible to the person they reported is a reporter who
    // stops reporting.
    match /reports/{reportId} {
      allow create: if request.auth != null
                    && request.resource.data.reporterId == request.auth.uid
                    && request.resource.data.status == 'open';
      allow read:   if isAdmin();
      allow update: if isAdmin();
      allow delete: if false;
    }

    // Content pulled out of circulation by three reports, pending review.
    // Written and restored only by the moderation functions; readable only
    // by an admin, which is what "hidden content is not readable by third
    // parties" means in practice. See the long note in lib/moderation.js
    // for why hiding moves the document instead of flagging it in place.
    match /moderationHidden/{docId} {
      allow read:  if isAdmin();
      allow write: if false;
    }

    // The distinct-reporter count behind the auto-hide threshold. Never
    // client-writable — the count is the whole mechanism.
    match /moderationCounters/{docId} {
      allow read:  if isAdmin();
      allow write: if false;
    }

    // Community leaderboard stats
    match /communityStats/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Friend requests
    match /friendRequests/{requestId} {
      allow read, write: if request.auth != null;
    }

    // Show tags (tag friends at shows)
    match /showTags/{tagId} {
      allow read, write: if request.auth != null;
    }

    // Venue ratings — user can only write their own
    match /venueRatings/{docId} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null
        && request.resource.data.userId == request.auth.uid;
    }

    // Wishlist — user's per-artist wishlist of songs to catch live.
    // Private: unlike venueRatings, only the owner can read their own docs.
    match /wishlists/{docId} {
      // `resource == null ||` covers reading an artist's wishlist doc
      // before it's ever been created (every first star for a new
      // artist) — without it, Firestore denies the read outright instead
      // of just returning "doesn't exist", since `resource` is null for a
      // nonexistent document and `resource.data` on null fails evaluation.
      allow read: if request.auth != null
        && (resource == null || resource.data.userId == request.auth.uid);
      allow create, update: if request.auth != null
        && request.resource.data.userId == request.auth.uid;
    }

    // Favorite tours (v5.29.0) — one doc per user (id = uid) holding a map
    // of starred tour keys. Same owner-only, top-level shape as wishlists
    // above, including the `resource == null` read clause so a user who has
    // never starred a tour can read their (nonexistent) doc instead of
    // being denied outright. Unstarring only ever deletes a single map
    // field via updateDoc, so no `allow delete` is needed.
    //
    // The docId check is not redundant with the userId check. Matching on
    // the field alone would let any signed-in user write to
    // favoriteTours/<someone-else's-uid> as long as they set userId to
    // their own — overwriting that user's document and locking them out of
    // reading it back. This collection keys its docs by uid, so pinning
    // docId to the caller closes that off exactly.
    match /favoriteTours/{docId} {
      allow read: if request.auth != null
        && docId == request.auth.uid
        && (resource == null || resource.data.userId == request.auth.uid);
      allow create, update: if request.auth != null
        && docId == request.auth.uid
        && request.resource.data.userId == request.auth.uid;
    }

    // Bucket List — user's saved future shows they want to attend.
    // Private, same shape as wishlists: only the owner can read their own
    // docs. Unlike wishlists (which only ever deletes a single song field
    // via updateDoc), removeFromBucketList() deletes the whole doc, so this
    // needs an explicit `allow delete` — Firestore denies deletes by
    // default without one. The `resource == null` clause on read lets a
    // user with an empty bucket list query the collection before they've
    // ever added anything, without being denied on a null resource.
    match /bucketList/{docId} {
      allow read: if request.auth != null
        && (resource == null || resource.data.userId == request.auth.uid);
      allow create, update: if request.auth != null
        && request.resource.data.userId == request.auth.uid;
      allow delete: if request.auth != null
        && resource.data.userId == request.auth.uid;
    }

    // Venue bucket list — venues (not specific shows) a user wants to see
    // any show at. Same owner-only shape as bucketList above; matched
    // against favorite artists' upcoming events by the daily
    // venue-bucket-list-notifications scheduled function (admin SDK,
    // bypasses these rules entirely).
    match /bucketListVenues/{docId} {
      allow read: if request.auth != null
        && (resource == null || resource.data.userId == request.auth.uid);
      allow create, update: if request.auth != null
        && request.resource.data.userId == request.auth.uid;
      allow delete: if request.auth != null
        && resource.data.userId == request.auth.uid;
    }

    // Friend activity feed — append-only log of add/rate events, read by
    // friends via a `userId in [...]` query. Privacy is enforced by the app
    // (lib/activityFeed.js checks the actor's shareActivity setting before
    // writing) rather than by a per-doc ACL, matching the existing
    // showTags/showSuggestions precedent of "any authenticated user can
    // read/write, the app controls which queries it actually runs."
    match /userActivity/{docId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid;
      allow update, delete: if false;
    }

    // Concert comments — discussion keyed by concertKey (see
    // lib/comments.js for how that's computed), not by any one user's
    // private show doc, so any authenticated user can read/post. `likedBy`
    // is the only field an update may touch, and only to add/remove the
    // caller's own uid — not anyone else's, and not any other field.
    // Delete is limited to the comment's own author or the admin account
    // (kept in sync with ADMIN_EMAILS in lib/constants.js).
    // CREATE IS CLOSED TO CLIENTS (v5.32.0). Comments are written by
    // netlify/functions/moderate-content.js, which runs the content filter
    // first. This rule used to allow any signed-in user to add a document
    // with their own authorUid, which meant the filter was a suggestion:
    // anyone with the Firebase SDK could post straight past it. Guideline
    // 1.2 asks for objectionable material to be filtered BEFORE it is
    // published, and that is only true if there is exactly one way in.
    // The Admin SDK bypasses these rules, so the function is unaffected.
    match /showComments/{docId} {
      allow read: if request.auth != null;
      allow create: if false;
      allow update: if request.auth != null
        && isNotBanned()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likedBy'])
        && request.resource.data.likedBy.removeAll(resource.data.likedBy).hasOnly([request.auth.uid])
        && resource.data.likedBy.removeAll(request.resource.data.likedBy).hasOnly([request.auth.uid]);
      allow delete: if request.auth != null
        && (resource.data.authorUid == request.auth.uid || isAdmin());
    }

    // "New since your last visit" comment highlighting — private
    // per-user/per-concert marker, same shape as wishlists/bucketList.
    // `resource == null ||` covers the very first visit to a concert's
    // comments, before this doc exists yet.
    match /commentViews/{docId} {
      allow read: if request.auth != null
        && (resource == null || resource.data.uid == request.auth.uid);
      allow write: if request.auth != null
        && request.resource.data.uid == request.auth.uid;
    }

    // Group meetups — one doc per concert (keyed the same way as
    // showComments, off a shared concertKey rather than any one user's
    // private bucket-list/show doc, since attendees each have their own
    // private "I'm going" record and there's no single shared show doc to
    // attach this to). Creating the doc seeds attendeeUids with just the
    // creator; joining/leaving afterward is restricted to adding or
    // removing only the caller's own uid, mirroring showComments' likedBy
    // pattern. The organizer alone may edit the pinned `description`.
    // Meetup documents carry one piece of free text, the organizer's
    // `description`. As of v5.36.2 that field is closed to clients on
    // both create and update and is written only by
    // moderate-content.js, which filters it. Creating and joining stay
    // direct writes — neither introduces text — and what they gain here
    // is the ban check: a banned account cannot start a meetup, join one,
    // or edit its pinned details.
    match /meetups/{meetupId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && isNotBanned()
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.attendeeUids == [request.auth.uid]
        // Seeded empty. Creating with a description would be the way
        // round the update rule below.
        && request.resource.data.get('description', '') == '';
      allow update: if request.auth != null && isNotBanned() && (
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['attendeeUids', 'attendeeNames'])
          && request.resource.data.attendeeUids.removeAll(resource.data.attendeeUids).hasOnly([request.auth.uid])
          && resource.data.attendeeUids.removeAll(request.resource.data.attendeeUids).hasOnly([request.auth.uid]))
        ||
        // `description` is NOT here any more: it is published text every
        // attendee reads, and this rule only ever decided WHO may write
        // it, never WHAT. The organizer could publish a slur with the
        // client-side filter skipped. It now goes through
        // moderate-content.js, which checks organizer ownership itself
        // because its Admin SDK writes bypass this rule.
        (resource.data.createdBy == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['updatedAt']))
      );
      allow delete: if false;
    }

    // Meetup discussion thread — flat (no replies/likes), same
    // author-owns-their-own-comment shape as showComments.
    // Create closed to clients for the same reason as showComments above
    // — a meetup thread is user-generated text other attendees read, so it
    // goes through moderate-content.js and its filter.
    match /meetupComments/{docId} {
      allow read: if request.auth != null;
      allow create: if false;
      allow delete: if request.auth != null
        && (resource.data.authorUid == request.auth.uid || isAdmin());
    }

    // Concert photos/videos — metadata doc for each upload (see
    // lib/photos.js). Same shape as showComments: keyed by concertKey,
    // any authenticated user can read/post, `likedBy` is the only
    // toggle-your-own-uid update allowed, delete is uploader-or-admin.
    // The actual file bytes live in Cloud Storage — see storage.rules for
    // the size/content-type limits enforced there.
    // Create closed to clients (v5.32.0): the metadata document carries
    // the caption, which is free text, so it is written by
    // moderate-content.js after the filter. The FILE still uploads
    // straight to Cloud Storage from the browser under storage.rules —
    // bytes are not text a wordlist can read, and routing tens of
    // megabytes through a function would be slower and no safer.
    match /showPhotos/{docId} {
      allow read: if request.auth != null;
      allow create: if false;
      allow update: if request.auth != null
        && isNotBanned()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likedBy'])
        && request.resource.data.likedBy.removeAll(resource.data.likedBy).hasOnly([request.auth.uid])
        && resource.data.likedBy.removeAll(request.resource.data.likedBy).hasOnly([request.auth.uid]);
      allow delete: if request.auth != null
        && (resource.data.uploadedBy == request.auth.uid || isAdmin());
    }

    // Ticket search cache
    match /ticketCache/{doc} {
      allow read, write: if request.auth != null;
    }

    // Pending email tags (for non-registered users)
    match /pendingEmailTags/{docId} {
      allow read, write: if request.auth != null;
    }

    // Invite tracking — sender and recipient can read their own invites
    match /invites/{docId} {
      allow read, write: if request.auth != null;
    }

    // Admin audit log
    match /adminAuditLog/{docId} {
      allow read, write: if request.auth != null;
    }

    // Show suggestions (were you there together?)
    match /showSuggestions/{docId} {
      allow read:   if request.auth != null
                    && request.auth.uid in resource.data.participants;
      allow create: if request.auth != null
                    && request.auth.uid in request.resource.data.participants;
      allow update: if request.auth != null
                    && request.auth.uid in resource.data.participants;
      allow delete: if false;
      match /comments/{commentId} {
        allow read: if request.auth != null
          && request.auth.uid in
             get(/databases/$(database)/documents/showSuggestions/$(docId)).data.participants;
        allow create: if request.auth != null
          && request.auth.uid in

             get(/databases/$(database)/documents/showSuggestions/$(docId)).data.participants
          && request.resource.data.authorUid == request.auth.uid;
        allow update: if request.auth != null
          && resource.data.authorUid == request.auth.uid;
        allow delete: if request.auth != null
          && resource.data.authorUid == request.auth.uid;
      }
    }

    // Public artist stats — written only by Netlify function via Admin SDK
    match /publicArtistStats/{slug} {
      allow read:  if true;
      allow write: if false;
    }

    // ── BUG FIX: Guest trial sessions ────────────────────────────────────────
    // Guests are unauthenticated — create and update must allow if true.
    // Reads are admin-only but we gate on auth (app enforces admin check).
    match /guestSessions/{sessionId} {
      allow create: if true;   // unauthenticated guest starts session
      allow update: if true;   // guest updates showsAdded; auth'd user marks converted
      allow read:   if request.auth != null;
      allow delete: if false;
    }

    // ── NEW: Roadmap (v1.0.24) ────────────────────────────────────────────────
    // Items are publicly readable (shown at /roadmap without login).
    // Writes are admin-managed; app enforces the admin check.
    match /roadmapItems/{itemId} {
      allow read: if true;
      allow write: if request.auth != null;

      // Per-user vote — each user can only read/write their own voter doc
      match /voters/{userId} {
        allow read:  if request.auth != null && request.auth.uid == userId;
        allow write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // ── NEW: Feedback submissions (v1.0.24) ───────────────────────────────────
    // Any authenticated user can submit; admin reads all.
    match /feedback/{docId} {
      allow create: if request.auth != null;
      allow read:   if request.auth != null;
      allow update: if request.auth != null;  // admin links roadmapItemId
      allow delete: if false;
    }

    // ── NEW: In-app notifications (v1.0.24) ───────────────────────────────────
    // Admin creates; recipient reads and marks read.
    match /notifications/{notifId} {
      allow create: if request.auth != null;
      allow read:   if request.auth != null
                    && resource.data.uid == request.auth.uid;
      allow update: if request.auth != null
                    && resource.data.uid == request.auth.uid;
      allow delete: if false;
    }

    // ── NEW: Venue verification (v5.23.0) ─────────────────────────────────────
    // Venue is the first real venue entity — any authenticated user can read
    // (venue pages/badges are shown everywhere), but only the verified owner
    // (verifiedOwnerUid) or the admin account can edit it. isVerified/
    // verifiedOwnerUid/verifiedDate are only ever set by the admin approval
    // flow, enforced client-side (same trust model AdminView.jsx already
    // uses for roadmap publishing) — a malicious update from a non-owner is
    // blocked by the owner check below either way.
    match /venues/{venueKey} {
      allow read:   if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null
                    && (resource.data.verifiedOwnerUid == request.auth.uid
                        || request.auth.token.email == 'phillip.leonard@gmail.com');
      allow delete: if false;
    }

    // ── Shared festival catalog (v5.30.0) ──────────────────────────────
    // The canonical, shared half of a festival: one document per real
    // festival edition, holding only facts about the event itself — name,
    // normalized name, dates, location, optional edition, creator.
    // NOTHING PERSONAL lives here; a user's notes, rating and attached
    // shows stay in their own users/{uid}/festivals record above. This is
    // the one collection in this release that is readable more widely than
    // before: festival names, dates and locations, which were private
    // per-user records until now, are readable by any signed-in user. That
    // is the entire point of the change — it's what lets one user find and
    // join the festival another user already created — and it is the only
    // read widening in this file. No personal field became readable.
    //
    // Same shape as /venues above (shared catalog, signed-in read,
    // creator-or-admin update, no client delete), with field validation
    // added because these documents are created by clients from free text.
    //
    // Not deletable by clients AT ALL, deliberately: once anyone else has
    // attended a festival, deleting it would break their page, and a rule
    // can't cheaply count other users' private attendance records to tell
    // whether that has happened. Leaving a festival deletes only the
    // leaver's own attendance record (which the rule above governs) and
    // never touches this document — including when the leaver is its
    // creator. Cleaning up a genuinely unwanted canonical festival is an
    // admin operation through the Admin SDK, which bypasses these rules.
    match /festivals/{festivalId} {
      allow read: if request.auth != null;

      allow create: if request.auth != null
                    && request.resource.data.createdBy == request.auth.uid
                    && request.resource.data.keys().hasOnly([
                         'name', 'nameNormalized', 'startDate', 'endDate',
                         'location', 'edition', 'createdBy', 'createdAt', 'updatedAt'
                       ])
                    && request.resource.data.keys().hasAll([
                         'name', 'nameNormalized', 'startDate', 'endDate', 'createdBy'
                       ])
                    && request.resource.data.name is string
                    && request.resource.data.name.size() > 0
                    && request.resource.data.name.size() <= 120
                    && request.resource.data.nameNormalized is string
                    && request.resource.data.nameNormalized.size() <= 120
                    // yyyy-MM-dd, and an end that is not before the start.
                    // String comparison is exact for this format.
                    && request.resource.data.startDate is string
                    && request.resource.data.startDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
                    && request.resource.data.endDate is string
                    && request.resource.data.endDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
                    && request.resource.data.endDate >= request.resource.data.startDate;

      // Only the creator (or admin) may edit the shared details. Everyone
      // else edits their own attendance record instead. createdBy can
      // never move, so a festival's creator is fixed at creation.
      allow update: if request.auth != null
                    && (resource.data.createdBy == request.auth.uid
                        || request.auth.token.email == 'phillip.leonard@gmail.com')
                    && request.resource.data.createdBy == resource.data.createdBy
                    && request.resource.data.keys().hasOnly([
                         'name', 'nameNormalized', 'startDate', 'endDate',
                         'location', 'edition', 'createdBy', 'createdAt', 'updatedAt'
                       ])
                    && request.resource.data.name is string
                    && request.resource.data.name.size() > 0
                    && request.resource.data.name.size() <= 120
                    && request.resource.data.startDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
                    && request.resource.data.endDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
                    && request.resource.data.endDate >= request.resource.data.startDate;

      allow delete: if false;
    }

    // Applications: applicant creates their own; only the applicant or the
    // admin can read (documents may contain sensitive business info);
    // status/reviewedDate/reviewerNotes/rejectionReason are only ever
    // written by the admin approval flow.
    match /venueVerificationApplications/{appId} {
      allow create: if request.auth != null
                    && request.resource.data.applicantUid == request.auth.uid;
      allow read:   if request.auth != null
                    && (resource.data.applicantUid == request.auth.uid
                        || request.auth.token.email == 'phillip.leonard@gmail.com');
      allow update: if request.auth != null
                    && request.auth.token.email == 'phillip.leonard@gmail.com';
      allow delete: if false;
    }

    // Official venue announcements — anyone can read, only the verified
    // owner can post (enforced client-side via venue.verifiedOwnerUid; the
    // Firestore rule can't cheaply look up the venue doc's owner here, so
    // this mirrors the "app decides who deserves a write" precedent
    // already used for notifications above).
    match /venueAnnouncements/{docId} {
      allow read:   if request.auth != null;
      allow create: if request.auth != null;
      allow update: if false;
      allow delete: if request.auth != null
                    && request.auth.token.email == 'phillip.leonard@gmail.com';
    }

    // Official venue photos.
    match /venuePhotos/{docId} {
      allow read:   if request.auth != null;
      allow create: if request.auth != null
                    && request.resource.data.uploadedBy == request.auth.uid;
      allow update: if false;
      allow delete: if request.auth != null
                    && (resource.data.uploadedBy == request.auth.uid
                        || request.auth.token.email == 'phillip.leonard@gmail.com');
    }

    // User reports of fake/duplicate/inaccurate venues — reporter creates,
    // only the admin reads/resolves.
    match /venueReports/{docId} {
      allow create: if request.auth != null
                    && request.resource.data.reporterUid == request.auth.uid;
      allow read:   if request.auth != null
                    && request.auth.token.email == 'phillip.leonard@gmail.com';
      allow update: if request.auth != null
                    && request.auth.token.email == 'phillip.leonard@gmail.com';
      allow delete: if false;
    }

    // ── Email: unsubscribes and announcements (v5.38.0) ────────────────
    // Server-only, admins included: every read and write goes through a
    // Netlify function with the Admin SDK (unsubscribe, send-email,
    // update-email-preferences, admin-send-announcement,
    // admin-list-unsubscribes). emailSuppressions holds the real address
    // of people who never signed up; unsubscribeEvents is the append-only
    // log; emailRateLimits is send-email's per-sender counter. No client
    // has any business touching them, so no client can.
    match /announcements/{announcementId}/{document=**} {
      allow read, write: if false;
    }
    match /announcements/{announcementId} {
      allow read, write: if false;
    }
    match /emailSuppressions/{emailHash} {
      allow read, write: if false;
    }
    match /unsubscribeEvents/{eventId} {
      allow read, write: if false;
    }
    match /emailRateLimits/{uid} {
      allow read, write: if false;
    }

    // ── NEW: Year in Review (v5.23.0) ──────────────────────────────────────
    // One doc per user per year (docId `${uid}_${year}`). Owner always
    // reads/writes their own; anyone can read a doc the owner has marked
    // public (for the shareable link), enforced by the `privacy` field.
    match /yearInReviews/{docId} {
      allow read:   if request.auth != null
                    && (resource.data.userId == request.auth.uid
                        || resource.data.privacy == 'public');
      allow create: if request.auth != null
                    && request.resource.data.userId == request.auth.uid;
      allow update: if request.auth != null
                    && resource.data.userId == request.auth.uid;
      allow delete: if false;
    }
  }
}
